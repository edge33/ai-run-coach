{
  "name": "running-data-hub",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "mcp": "node --env-file-if-exists=.env apps/mcp/src/stdio.ts",
    "db:init": "node --env-file-if-exists=.env scripts/initialize.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  }
}
