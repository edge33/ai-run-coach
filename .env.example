# Native development paths are resolved from the repository root.
SQLITE_PATH=data/db/coach.sqlite
WIKI_PATH=athlete_wiki
ATHLETE_TIMEZONE=Europe/Rome
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0

# Local Vite/API/MCP origins. Compose: set this to http://YOUR_TAILSCALE_IP:8080
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Required for Compose. Set your homelab's existing Tailscale address.
TAILSCALE_IP=
