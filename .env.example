# Native development paths are resolved from the repository root.
SQLITE_PATH=data/db/coach.sqlite
WIKI_PATH=data/athlete_wiki
ATHLETE_TIMEZONE=Europe/Rome
GARMIN_API_KEY=
# info: import lifecycle and failures; debug: every Garmin request/response summary.
LOG_LEVEL=info
# Minimum gap between Garmin request starts; conservative pacing, not a documented Garmin quota.
GARMIN_REQUEST_INTERVAL_MS=1000

# Local Vite/API/MCP origins. Compose: set this to http://YOUR_HOST:8080
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Compose bind address; defaults to loopback. Set a host interface address for remote access.
BIND_IP=127.0.0.1

# Compose host data directory (relative paths resolve from compose.yaml).
DATA_PATH=./data
