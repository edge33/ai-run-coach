{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["biome.json", "packages/config/**", "pnpm-lock.yaml"],
  "globalPassThroughEnv": ["SMOKE_ORIGIN"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^transit"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": []
    }
  }
}
